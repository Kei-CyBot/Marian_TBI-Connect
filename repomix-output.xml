<file path="resources/views/partials/event-slideover.blade.php">
{{-- Create / Edit Event drawer. Open with: $dispatch('open-event-form')  or  $dispatch('open-event-form', eventObject) --}}
<div x-data="{
        open:false, editing:false,
        types:{
            internal:['Campus Hackathon','TTO Commercialization Workshop','Student Founder Bootcamp','Internal Demo Day'],
            external:['VC Investor Pitch Night','Corporate Partner Matchmaking','Regional Startup Summit','Industry Masterclass'],
            hybrid:['Open Innovation Expo','Public Demo Day']
        },
        f:{title:'',scope:'internal',kind:'',date:'',time:'',mode:'physical',loc:'',host:'',cohort:''},
        get accent(){ return this.f.scope==='internal' ? '#b92369' : this.f.scope==='external' ? '#1a8a8e' : null },
        load(e){
            this.editing = !!(e && e.id);
            this.f = e && e.id
                ? {title:e.title,scope:e.scope,kind:e.kind,date:e.date,time:e.time,mode:e.virtual?'virtual':'physical',loc:e.loc,host:e.host,cohort:e.cohort}
