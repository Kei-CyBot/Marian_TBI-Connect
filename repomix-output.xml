                    <div class="min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-wider text-white/70" x-text="'Form '+formId+' · '+form.category"></p>
                        <h2 class="truncate text-lg font-bold" x-text="form.title"></h2>
