{{-- Integrated Mass Email Dispatcher. Open with: $dispatch('open-broadcast')  or  $dispatch('open-broadcast', eventObject) --}}
<div x-data="{
        open:false, sent:false, testSent:false, eventTitle:null,
        audiences:[
            {id:'active',   label:'All Active Incubatees',    count:48,  track:'all'},
            {id:'faculty',  label:'Internal Faculty Founders', count:21,  track:'internal'},
            {id:'mentors',  label:'External Industry Mentors', count:37,  track:'external'},
            {id:'vcs',      label:'Vetted VCs / Investors',    count:24,  track:'external'},
            {id:'alumni',   label:'Alumni Network',            count:73,  track:'all'}
        ],
        selected:[],
        templates:{
            '':{subject:'',body:''},
            invite:{subject:'You are invited: {event_name}',body:'Hi {founder_name},\n\nWe would love to see {startup_name} at {event_name}. Please confirm your RSVP using the link below.\n\nBest,\nThe IncubaTech Team'},
            newsletter:{subject:'Monthly Progress Newsletter — October',body:'Hi {founder_name},\n\nHere is what happened across the ecosystem this month, including updates relevant to {startup_name}.\n\nBest,\nThe IncubaTech Team'},
            review:{subject:'Quarterly Review Reminder for {startup_name}',body:'Hi {founder_name},\n\nThis is a reminder that your quarterly review for {startup_name} is coming up. Please submit your Progress Monitoring form beforehand.\n\nBest,\nThe IncubaTech Team'}
        },
        tpl:'', subject:'', body:'',
        vars:['{founder_name}','{startup_name}','{event_name}'],
        files:[
            {id:1,name:'Event Agenda.pdf',size:'210 KB',sync:true},
            {id:2,name:'Quarterly Work Plan Template.docx',size:'95 KB',sync:true},
            {id:3,name:'Investor Pitch Guidelines.pdf',size:'480 KB',sync:true},
            {id:4,name:'Lab Safety Briefing.pdf',size:'1.1 MB',sync:false}
        ],
        attached:[], fileMenu:false,
        get recipients(){
            // Mock de-duplication: groups overlap, so estimate ~12% fewer unique people when 2+ groups are picked
            const sum = this.audiences.filter(a=>this.selected.includes(a.id)).reduce((t,a)=>t+a.count,0);
            return this.selected.length>1 ? Math.round(sum*0.88) : sum;
        },
        get ready(){ return this.selected.length && this.subject.trim() && this.body.trim() },
        show(e){
            this.open=true; this.sent=false; this.testSent=false;
            this.eventTitle = e && e.title ? e.title : null;
            if(this.eventTitle){ this.applyTpl('invite'); this.tpl='invite'; this.subject=this.subject.replace('{event_name}', this.eventTitle); this.body=this.body.replace(/\{event_name\}/g, this.eventTitle) }
        },
        applyTpl(k){ const t=this.templates[k||'']; this.subject=t.subject; this.body=t.body },
        insertVar(v){
            const ta=this.$refs.body, s=ta.selectionStart ?? this.body.length, en=ta.selectionEnd ?? this.body.length;
            this.body = this.body.slice(0,s)+v+this.body.slice(en);
            this.$nextTick(()=>{ ta.focus(); ta.selectionStart=ta.selectionEnd=s+v.length });
        },
        toggleFile(f){ this.attached.includes(f.id) ? this.attached=this.attached.filter(i=>i!==f.id) : this.attached.push(f.id) },
        reset(){ this.selected=[]; this.tpl=''; this.subject=''; this.body=''; this.attached=[] }
     }"
     @open-broadcast.window="reset(); show($event.detail)"
     @keydown.escape.window="open=false">

