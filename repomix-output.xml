<file path="routes/web.php">
<?php

use App\Models\User;
use Illuminate\Http\Request;
use Illuminate\Support\Facades\Auth;
use Illuminate\Support\Facades\Route;
use Laravel\Socialite\Facades\Socialite;

Route::view('/startup-form', 'public.startup-form')->name('startup-form');
Route::view('/alumni-form', 'public.alumni-form')->name('alumni-form');
Route::view('/contact-registration', 'public.contact-registration')->name('contact-registration');

Route::get('/', function () {
    return Auth::check() ? redirect()->route('dashboard') : view('login');
})->name('home');

Route::middleware('guest')->group(function (): void {
    Route::get('/login', fn () => view('login'))->name('login');

    Route::post('/login', function (Request $request) {
        $credentials = $request->validate([
            'email' => ['required', 'string', 'email'],
            'password' => ['required', 'string'],
            'remember' => ['nullable', 'boolean'],
        ]);

        if (! Auth::attempt(
            ['email' => $credentials['email'], 'password' => $credentials['password']],
            $request->boolean('remember')
        )) {
            return back()
                ->withErrors(['email' => 'The provided credentials do not match our records.'])
                ->onlyInput('email');
        }

        $request->session()->regenerate();

        return redirect()->intended(route('dashboard'));
    })->middleware('throttle:5,1')->name('login.store');

    Route::get('/auth/google/redirect', function () {
        abort_unless(
            class_exists(Socialite::class),
            503,
            'Google sign-in requires the laravel/socialite package and Google OAuth credentials.'
        );
        abort_unless(
            config('services.google.client_id') && config('services.google.client_secret'),
            503,
            'Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET before enabling Google sign-in.'
        );

        return Socialite::driver('google')->redirect();
    })->name('auth.google.redirect');

    Route::get('/auth/google/callback', function (Request $request) {
        abort_unless(
            class_exists(Socialite::class),
            503,
            'Google sign-in requires the laravel/socialite package and Google OAuth credentials.'
        );
        abort_unless(
            config('services.google.client_id') && config('services.google.client_secret'),
            503,
            'Set GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET before enabling Google sign-in.'
        );

        $googleUser = Socialite::driver('google')->user();
        $email = $googleUser->getEmail();
        $isVerified = filter_var($googleUser->user['verified_email'] ?? false, FILTER_VALIDATE_BOOLEAN);

        abort_unless($email && $isVerified, 403, 'Google could not verify this account.');

        $user = User::query()->where('email', $email)->first();
        abort_unless($user, 403, 'This Google account is not authorized for IncubaTech OS.');

        Auth::login($user);
        $request->session()->regenerate();

        return redirect()->intended(route('dashboard'));
    })->name('auth.google.callback');
});

Route::post('/logout', function (Request $request) {
    Auth::logout();
    $request->session()->invalidate();
    $request->session()->regenerateToken();

    return redirect()->route('login');
})->middleware('auth')->name('logout');

Route::middleware('auth')->group(function (): void {
    Route::view('/dashboard', 'dashboard')->name('dashboard');
    Route::view('/incubatees', 'incubatees')->name('incubatees');
    Route::view('/contacts', 'contacts')->name('contacts');
    Route::view('/contact-intake', 'contact-intake')->name('contact-intake');
    Route::view('/technical-needs', 'technical-needs')->name('technical-needs');
    Route::view('/files', 'files')->name('files');
    Route::view('/events', 'events')->name('events');
    Route::view('/team', 'team')->name('team');
    Route::view('/archives', 'archives')->name('archives');

    Route::view('/forms', 'forms')->name('forms');
    Route::view('/assessments', 'assessments')->name('assessments');
});
