<div x-data="{
        items:@js($items), kind:'All', sel:[], confirm:null, toast:'',
        kinds:['All','Startup','Contact','File','Form','Event'],
        get list(){ return this.items.filter(i => (scope==='all' || i.track===scope) && (this.kind==='All' || i.kind===this.kind)) },
        get allOn(){ return this.list.length && this.list.every(i => this.sel.includes(i.id)) },
        toggleAll(){ this.sel = this.allOn ? [] : this.list.map(i=>i.id) },
        restore(ids){ this.items=this.items.filter(i=>!ids.includes(i.id)); this.sel=[]; this.flash(ids.length+' item(s) restored') },
        purge(ids){ this.items=this.items.filter(i=>!ids.includes(i.id)); this.sel=[]; this.confirm=null; this.flash(ids.length+' item(s) permanently deleted') },
        flash(m){ this.toast=m; setTimeout(()=>this.toast='',2500) }
     }">

    <div class="mb-4 flex flex-wrap items-center gap-3">
        <div class="inline-flex rounded-2xl border border-slate-line bg-white p-1 text-sm font-semibold">
