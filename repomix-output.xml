<file path="app/Support/Forms/FormEditorSchema.php">
<?php

namespace App\Support\Forms;

use App\Helpers\FormFormatHelper;

/**
 * Resolves the rich editor field list for a saved submission: schema-driven
 * controls (select / radio / checkbox / date / textarea …) matching the React
 * form catalog, plus a plain-text fallback for any scalar key the schema does
 * not know, so every saved value stays editable.
 */
final class FormEditorSchema
{
    /**
     * @param  array<string, mixed>  $data
     * @return list<array{key: string, label: string, type: string, options: list<array{value: string, label: string}>, value: mixed, editable: bool}>
     */
    public static function forSubmission(int $formId, array $data): array
    {
        $schema = config('form_editor.forms')[$formId] ?? [];
        $fields = [];
        $claimed = [];

        foreach ($schema as $key => $definition) {
            $key = (string) $key;
            if (! array_key_exists($key, $data)) {
                continue;
            }

            $claimed[$key] = true;
            $type = $definition['type'] ?? 'text';
            $value = $data[$key];

            if ($type === 'readonly') {
                $fields[] = [
                    'key' => $key,
                    'label' => (string) ($definition['label'] ?? FormFormatHelper::toLabel($key)),
                    'type' => 'text',
                    'options' => [],
                    'value' => is_scalar($value) || $value === null ? (string) $value : '',
                    'editable' => false,
                ];

                continue;
            }

            if ($type === 'checkbox') {
                $fields[] = [
                    'key' => $key,
                    'label' => (string) ($definition['label'] ?? FormFormatHelper::toLabel($key)),
                    'type' => 'checkbox',
                    'options' => [],
                    'value' => filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE) ?? (bool) $value,
                    'editable' => true,
                ];

                continue;
            }

            $scalar = is_scalar($value) || $value === null;
            if (! $scalar) {
                // Structured value saved for a schema field: keep it preserved instead.
                continue;
            }

            $stringValue = (string) $value;

            if ($type === 'select' || $type === 'radio') {
                $options = self::normalizeOptions($definition['options'] ?? []);
                $optionValues = array_column($options, 'value');
                if ($stringValue !== '' && ! in_array($stringValue, $optionValues, true)) {
                    array_unshift($options, ['value' => $stringValue, 'label' => $stringValue]);
                }

                $fields[] = [
                    'key' => $key,
                    'label' => (string) ($definition['label'] ?? FormFormatHelper::toLabel($key)),
                    'type' => $type,
                    'options' => $options,
                    'value' => $stringValue,
                    'editable' => true,
                ];

                continue;
            }

            $fields[] = [
                'key' => $key,
                'label' => (string) ($definition['label'] ?? FormFormatHelper::toLabel($key)),
                'type' => in_array($type, ['text', 'email', 'date', 'textarea'], true) ? $type : 'text',
                'options' => [],
                'value' => $stringValue,
                'editable' => true,
            ];
        }

        foreach ($data as $key => $value) {
            $key = (string) $key;
            if (isset($claimed[$key]) || $key === 'signer_name') {
                continue;
            }
            if (! is_scalar($value) && $value !== null) {
                continue;
            }

            $fields[] = [
                'key' => $key,
                'label' => FormFormatHelper::toLabel($key),
                'type' => 'text',
                'options' => [],
                'value' => $value === null ? '' : (string) $value,
                'editable' => true,
            ];
        }

        return $fields;
    }

    /**
     * Keys whose values the editor submits (everything else is preserved verbatim
     * through data_complex, including readonly and structured keys).
     *
     * @param  list<array{key: string, editable: bool}>  $fields
     * @return list<string>
     */
    public static function editableKeys(array $fields): array
    {
        return array_values(array_map(
            static fn (array $field): string => $field['key'],
            array_filter($fields, static fn (array $field): bool => (bool) ($field['editable'] ?? false))
        ));
    }

    /**
     * Accepts both list-style options (value === label) and maps (value => label).
     *
     * @return list<array{value: string, label: string}>
     */
    private static function normalizeOptions(mixed $options): array
    {
        if (! is_array($options)) {
            return [];
        }

        if (array_is_list($options)) {
            return array_map(
                static fn (mixed $option): array => [
                    'value' => (string) $option,
                    'label' => (string) $option,
                ],
                $options
            );
        }

        $normalized = [];
        foreach ($options as $value => $label) {
            $normalized[] = ['value' => (string) $value, 'label' => (string) $label];
        }

        return $normalized;
    }
}
</file>

<file path="app/Support/Forms/StartupFormCatalog.php">
<?php

namespace App\Support\Forms;

use App\DTOs\Forms\FormDefinitionData;
use App\DTOs\Forms\PrerequisiteDocumentData;
use App\Enums\Forms\FormCategory;
use InvalidArgumentException;

final class StartupFormCatalog
{
    /** @var array<int, FormDefinitionData>|null */
    private ?array $formsById = null;

    /**
     * @return list<FormDefinitionData>
     */
    public function all(): array
    {
        return array_values($this->definitions());
    }

    public function find(int $id): ?FormDefinitionData
    {
        return $this->definitions()[$id] ?? null;
    }

    /**
     * @return list<array<string, mixed>>
     */
    public function forFrontend(): array
    {
        return array_map(
            static fn (FormDefinitionData $form): array => $form->toArray(),
            $this->all()
        );
    }

    /**
     * @return array<int, FormDefinitionData>
     */
    private function definitions(): array
    {
        if ($this->formsById !== null) {
            return $this->formsById;
        }

        $forms = [];
        foreach (config('startup_forms', []) as $definition) {
            if (! is_array($definition)
                || ! isset($definition['id'], $definition['name'], $definition['category'], $definition['attachment_only'])
                || ! is_int($definition['id'])
                || ! is_string($definition['name'])
                || ! is_string($definition['category'])
                || ! is_bool($definition['attachment_only'])) {
                throw new InvalidArgumentException('Startup form configuration has an invalid definition.');
            }

            $category = FormCategory::tryFrom($definition['category']);
            if ($category === null) {
                throw new InvalidArgumentException('Startup form configuration contains an unknown category.');
            }

            $prerequisiteConfig = $definition['prerequisite'] ?? null;
            $prerequisite = null;
            if ($prerequisiteConfig !== null) {
                if (! is_array($prerequisiteConfig)
                    || ! isset(
                        $prerequisiteConfig['key'],
                        $prerequisiteConfig['required'],
                        $prerequisiteConfig['allowed_extensions'],
                        $prerequisiteConfig['max_kilobytes'],
                        $prerequisiteConfig['filename_pattern'],
                    )
                    || ! is_string($prerequisiteConfig['key'])
                    || ! is_bool($prerequisiteConfig['required'])
                    || ! is_array($prerequisiteConfig['allowed_extensions'])
                    || ! is_int($prerequisiteConfig['max_kilobytes'])
                    || ! is_string($prerequisiteConfig['filename_pattern'])) {
                    throw new InvalidArgumentException('Startup form prerequisite configuration is invalid.');
                }

                $prerequisite = new PrerequisiteDocumentData(
                    key: $prerequisiteConfig['key'],
                    label: $definition['name'],
                    required: $prerequisiteConfig['required'],
                    allowedExtensions: $prerequisiteConfig['allowed_extensions'],
                    maxKilobytes: $prerequisiteConfig['max_kilobytes'],
                    filenamePattern: $prerequisiteConfig['filename_pattern'],
                );
            }

            if ($definition['attachment_only'] !== ($prerequisite !== null)) {
                throw new InvalidArgumentException('Attachment-only forms must define prerequisite documents.');
            }

            $forms[$definition['id']] = new FormDefinitionData(
                id: $definition['id'],
                name: $definition['name'],
                category: $category,
                attachmentOnly: $definition['attachment_only'],
                prerequisite: $prerequisite,
            );
        }

        if (count($forms) !== count(config('startup_forms', []))) {
            throw new InvalidArgumentException('Startup form catalog contains duplicate form IDs.');
        }

        return $this->formsById = $forms;
    }
}
</file>

