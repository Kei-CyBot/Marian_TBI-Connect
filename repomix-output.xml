        <div class="ml-auto flex gap-2" x-show="sel.length" x-cloak x-transition>
            <button @click="restore(sel)" class="rounded-xl bg-[#1a8a8e] px-4 py-2 text-sm font-semibold text-white hover:bg-[#146e72]">Restore (<span x-text="sel.length"></span>)</button>
            <button @click="confirm=sel" class="rounded-xl bg-[#b92369] px-4 py-2 text-sm font-semibold text-white hover:bg-[#9a1b55]">Delete permanently</button>
