                            </div>
                            <textarea x-ref="body" x-model="body" rows="8" placeholder="Write your message…" class="w-full rounded-xl border border-slate-line px-3 py-2 focus:border-[#1a8a8e] focus:outline-none focus:ring-2 focus:ring-[#1a8a8e]/15"></textarea>
