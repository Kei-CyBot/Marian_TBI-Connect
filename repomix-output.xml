                <p class="text-xs text-gray-400" x-show="!ready">Pick an audience and add a subject and message.</p>
                <span x-show="ready"></span>
                <div class="flex gap-2">
                    <button @click="open=false" class="rounded-xl border border-gray-200 px-4 py-2 text-sm font-medium text-gray-700">Cancel</button>
                    <button @click="sent=true" :disabled="!ready" class="rounded-xl bg-[#b92369] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#9a1b55] disabled:cursor-not-allowed disabled:opacity-40">Send to <span x-text="recipients"></span> recipients</button>
                </div>
            </div>
        </div>
    </div>
</div>
</file>

